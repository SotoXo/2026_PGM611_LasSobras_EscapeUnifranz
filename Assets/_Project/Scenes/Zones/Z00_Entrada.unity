  prompt: '[E] CCTV / seguridad'
  priority: 0
  interactionAvailable: 1
  requiredFlags: 
  requiredItem: 
  requirementMessage: "El dispositivo todav\xEDa no est\xE1 habilitado."
  terminalId: entrada
  powerFlag: 29
  feeds:
  - name: "CAM 01 \u2014 ENTRADA"
    schematic: "Puerta de acceso: necesita energ\xEDa y un c\xF3digo. La unidad depende
      del panel de alimentaci\xF3n local."
    clue: {fileID: 0}
    camera: {fileID: 598786319}
    noSignal: 0
  - name: "CAM 02 \u2014 HALL"
    schematic: "PLACA DEL LECTOR: 3174. Guarda el c\xF3digo y \xFAsalo en el lector
      del acceso."
    clue: {fileID: 11400000, guid: 80ad572ab2bc594439a8cfd2dc15e29b, type: 2}
    camera: {fileID: 0}
    noSignal: 0
  - name: "CAM 03 \u2014 AULA"
    schematic: Una ruta segura usa cobertura. Consulta el estado del robot local
      antes de salir.
    clue: {fileID: 0}
    camera: {fileID: 0}
    noSignal: 0
  - name: "CAM 04 \u2014 SIN SE\xD1AL"
    schematic: "La c\xE1mara perdi\xF3 la conexi\xF3n. Reiniciar un enlace no reemplaza
      un cable retirado."
    clue: {fileID: 0}
    camera: {fileID: 0}
    noSignal: 1
  optionalAudio: {fileID: 2051574643}
