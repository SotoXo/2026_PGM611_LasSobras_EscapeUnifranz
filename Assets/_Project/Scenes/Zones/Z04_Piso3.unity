    clue: {fileID: 0}
    camera: {fileID: 1042578785}
    noSignal: 0
  - name: "CAM 02 \u2014 HALL"
    schematic: "Gabinete de comunicaciones: requiere tarjeta de mantenimiento. Dentro
      hay un m\xF3dulo para Tecnolog\xEDa."
    clue: {fileID: 0}
    camera: {fileID: 0}
    noSignal: 0
  - name: "CAM 03 \u2014 AULA"
    schematic: Una ruta segura usa cobertura. Consulta el estado del robot local
      antes de salir.
    clue: {fileID: 0}
    camera: {fileID: 0}
    noSignal: 0
  - name: "CAM 04 \u2014 SIN SE\xD1AL"
    schematic: "La c\xE1mara perdi\xF3 la conexi\xF3n. Reiniciar un enlace no reemplaza
      un cable retirado."
    clue: {fileID: 0}
    camera: {fileID: 0}
    noSignal: 1
